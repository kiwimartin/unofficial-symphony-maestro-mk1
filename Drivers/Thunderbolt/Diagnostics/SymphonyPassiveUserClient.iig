#ifndef SymphonyPassiveUserClient_h
#define SymphonyPassiveUserClient_h
#include <DriverKit/IOUserClient.iig>
class SymphonyPassiveDiagnostics;
class SymphonyPassiveUserClient : public IOUserClient {
public:
    virtual bool init() override;
    virtual void free() override;
